# ==============================================
# Cheguei Mãe — Backend — Variáveis de Ambiente
# IMPORTANTE: Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env no Git
# ==============================================

# ─── Banco de Dados (MySQL) ───────────────────
# Desenvolvimento: use localhost + docker-compose
# Produção: use a Service URI do Aiven
DB_HOST=localhost
DB_PORT=3306
DB_USER=cheguei_user
DB_PASSWORD=cheguei_pass
DB_NAME=cheguei_mae

# ─── Servidor ─────────────────────────────────
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# ─── JWT ──────────────────────────────────────
# Em produção: use uma string aleatória longa (mínimo 32 chars)
# Gere com: openssl rand -hex 32
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────
# Em produção: adicione apenas as origens legítimas
# Exemplo: CORS_ORIGIN=https://meuapp.up.railway.app
CORS_ORIGIN=http://localhost:8081,http://192.168.15.3:8081,http://192.168.15.7:8081

# ─── Supabase Storage (uploads de arquivos) ───
# Necessário APENAS em produção (NODE_ENV=production)
# Em desenvolvimento, os arquivos são salvos na pasta uploads/ local
# Obtenha em: supabase.com → seu projeto → Settings → API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=sua_anon_public_key_aqui
SUPABASE_BUCKET=uploads