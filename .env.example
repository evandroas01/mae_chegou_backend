# ==============================================
# Cheguei Mãe — Backend — Variáveis de Ambiente
# IMPORTANTE: Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env no Git
# ==============================================

# ─── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# ─── Banco de Dados (PostgreSQL) ──────────────────────────────
# OPÇÃO 1 — DATABASE_URL (recomendado para produção no Render/Supabase/Neon)
# Cole aqui a connection string fornecida pelo seu provedor:
#   Render:   postgres://user:pass@host/dbname
#   Supabase: postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
#   Neon:     postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# OPÇÃO 2 — Variáveis individuais (para desenvolvimento local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cheguei_mae

# ─── JWT ──────────────────────────────────────────────────────
# Em produção: use uma string aleatória longa (mínimo 32 chars)
# Gere com: openssl rand -hex 32
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
# Em produção: adicione apenas as origens legítimas do seu frontend
# Exemplo: CORS_ORIGIN=https://meuapp.expo.dev,https://meuapp.com
CORS_ORIGIN=http://localhost:8081,http://192.168.15.3:8081,http://192.168.15.7:8081

# ─── Supabase Storage (uploads de arquivos) ───────────────────
# Necessário APENAS em produção (NODE_ENV=production)
# Em desenvolvimento, os arquivos são salvos na pasta uploads/ local
# Obtenha em: supabase.com → seu projeto → Settings → API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=sua_anon_public_key_aqui
SUPABASE_BUCKET=uploads